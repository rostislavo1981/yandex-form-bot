# Yandex Form Bot — environment variables
# Copy to .env, fill in, never commit .env

# === YandexGPT (parser) ===
# Get from https://yandex.cloud (folder → service account → API key)
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
# Model: "yandexgpt-lite" (cheap, MVP) or "yandexgpt" (pro)
YANDEX_GPT_MODEL=yandexgpt-lite
# Max tokens in response (default 2000 is enough for one Report)
YANDEX_GPT_MAX_TOKENS=2000

# === Yandex Forms ===
# Public URL of the published form (FILL target, not /admin/)
FORM_PUBLISHED_URL=

# === Yandex Disk (archive) ===
# OAuth token from https://oauth.yandex.ru
YANDEX_DISK_OAUTH_TOKEN=
YANDEX_DISK_REFRESH_TOKEN=
YANDEX_DISK_CLIENT_ID=
YANDEX_DISK_CLIENT_SECRET=
# Root folder for archives
YANDEX_DISK_ROOT=Яндекс Формы бот

# === MAX Bot (Telegram-compatible API) ===
MAX_BOT_TOKEN=
# Long polling: how many seconds to wait per getUpdates (max 30)
MAX_POLLING_TIMEOUT=25
# Default foreman name (MVP: single foreman)
DEFAULT_FOREMAN=Степанов

# === Storage ===
DATA_DIR=./data
# SQLite database path (relative to DATA_DIR)
DB_PATH=app.db

# === Logging ===
LOG_LEVEL=INFO

# === Strict mode ===
# Set to 1 to require all secrets at startup (prod). 0 = dev (warn only).
STRICT_CONFIG=0
