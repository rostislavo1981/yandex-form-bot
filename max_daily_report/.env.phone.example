# Isolated local stand for testing from a phone through MAX.
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Filled after the Cloudflare quick tunnel starts.
WEBAPP_PUBLIC_URL=

# MAX credentials. Keep the real token only in .env.phone (gitignored).
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=replace-with-a-random-test-secret
MAX_GROUP_ID=

# Protects scheduler/worker endpoints inside the Docker network.
INTERNAL_TOKEN=replace-with-a-random-internal-token

SCHEDULER_TIMEZONE=Europe/Moscow
