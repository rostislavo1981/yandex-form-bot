# Application
APP_NAME="MAX Daily Report"
DEBUG=false
# Set to true to enable dev-only auth fallback and auto-seed dev-user
APP_ENV=production

# Database
DATABASE_URL=postgresql+asyncpg://mdr_user:mdr_pass@localhost:5432/mdr_db

# MAX Bot API (fill in production)
MAX_BOT_TOKEN=
# Username бота (для deep-link max.ru/<username>?startapp=report)
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
MAX_GROUP_ID=
# Публичный URL Mini App (fallback для ссылок, если username не задан)
WEBAPP_PUBLIC_URL=

# Shared secret для /api/scheduler/* и /api/worker/*.
# Пустое значение разрешает доступ только в APP_ENV=dev.
INTERNAL_TOKEN=

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Production deployment
# DOMAIN=:80 — локальный HTTP; DOMAIN=example.com — прод с авто-HTTPS (Let's Encrypt)
DOMAIN=:80
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
WORKER_POLL_SECONDS=2
SCHEDULER_TIMEZONE=Europe/Moscow
